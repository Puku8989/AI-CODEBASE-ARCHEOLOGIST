# AI Codebase Archaeologist Environment Configuration

# Application
PROJECT_NAME="AI Codebase Archaeologist"
VERSION="1.0.0"

# Database Configuration
# For local SQLite (Default):
DATABASE_URL=sqlite:///./data/codebase_archaeologist.db
# For PostgreSQL with pgvector (Docker/Production):
# DATABASE_URL=postgresql://archaeologist:archaeologist_secret@localhost:5432/codebase_db

# LLM Configuration (Phase 5)
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5-coder:3b
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=

# Processing Limits
MAX_REPO_SIZE_MB=250
MAX_FILE_SIZE_BYTES=1500000
CLONE_TIMEOUT_SECONDS=120
